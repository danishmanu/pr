# =====================================================================
# Online Pharmacy Platform - Environment Variables
# =====================================================================

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=pharmacy-super-secret-key-change-in-production-2026

# Database Configuration:
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Example: mysql+pymysql://root:root123@localhost:3306/online_pharmacy
# If MySQL connection fails or DB_BACKEND=sqlite, will fallback gracefully to SQLite.
DB_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=online_pharmacy

# SQLite fallback path
SQLITE_DB_PATH=pharmacy.db

# OCR & Tesseract Configuration:
# Specify the path to tesseract binary if not in system PATH
# Windows Default: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux Default: /usr/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Handwritten Prescription AI (Vision-Language Model):
# VISION_PROVIDER: auto | gemini | ollama | claude | none
#   auto   -> gemini if GEMINI_API_KEY is set, else claude if ANTHROPIC_API_KEY is set, else none
#   gemini -> free tier at https://aistudio.google.com/apikey (free-tier data may be used by Google; avoid real patient data)
#   ollama -> fully local and free: `ollama pull qwen2.5vl:7b` (needs ~8 GB RAM, not available on Render free tier)
#   claude -> paid Anthropic API, strongest handwriting accuracy
#   none   -> Tesseract only (printed prescriptions)
# If the vision call fails, the platform falls back to Tesseract automatically.
VISION_PROVIDER=auto
# Optional model override (defaults: gemini-flash-latest, qwen2.5vl:7b, claude-opus-5-5)
VISION_MODEL=
VISION_TIMEOUT=90
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# File Upload Configuration
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes
